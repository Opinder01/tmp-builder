# Supabase (new, dedicated project for dispatch-app — do NOT reuse tmpbuilder.ca's project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret used to encrypt QuickBooks OAuth tokens at rest and sign
# OAuth `state` params — any long random string.
TOKEN_ENCRYPTION_KEY=

# The app's own URL — used for CORS and for redirecting back after QuickBooks
# OAuth completes. Point this at wherever `npm run dev` is actually serving.
APP_ORIGIN=http://localhost:5173

# QuickBooks OAuth app (developer.intuit.com). QBO_REDIRECT_URI must be
# registered EXACTLY (including path) in the app's Intuit developer settings —
# it goes straight to the API dev server, not through Vite's proxy.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QBO_ENVIRONMENT=sandbox
# Optional: force contractor Bills to a specific QuickBooks Expense account
# (by Account Id) instead of the app's best-guess default.
QBO_CONTRACTOR_EXPENSE_ACCOUNT_ID=

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=

# Protects the /api/cron/reminders endpoint from being publicly triggerable
CRON_SECRET=

# Any date (ISO format) — the reminder cron fires every 14 days counting from
# this date. Defaults to 2026-01-05 if unset.
REMINDER_ANCHOR_DATE=
